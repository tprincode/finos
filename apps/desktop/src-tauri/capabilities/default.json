{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and Import wizard: FinanceClient IPC only",
  "windows": ["main", "import-wizard"],
  "permissions": [
    "core:default",
    "updater:allow-check",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-webview-close",
    "core:window:allow-close",
    "core:window:allow-set-focus"
  ]
}
