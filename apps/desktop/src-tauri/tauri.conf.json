{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "finos",
  "version": "0.1.0",
  "identifier": "com.finos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "finos",
        "width": 880,
        "height": 760,
        "decorations": true,
        "closable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": "CEAAACA78BB136405A1496C2DD39EB0E8975D6E6",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGNDQ1NzQyODY2MUY3OTYKUldTVzkyR0dRbGRFNzdVV3QxbXA0RkZ4SzRJWTlYc2JKR2hiV1kySjNmdGxCYm5Kem5FZ0dJMlcK",
      "endpoints": [
        "https://github.com/EVTom/finos/releases/latest/download/latest.json"
      ]
    }
  }
}
